        ],
        "url": {
          "raw": "{{base_url}}/pesanan.php",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "pesanan.php"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id_user\": 3,\n  \"nama_penerima\": \"Budi Pembeli\",\n  \"alamat_kirim\": \"Jl. Melati No. 12, Bengkulu\",\n  \"no_hp\": \"081200000003\",\n  \"catatan\": \"Tolong dikemas rapi\",\n  \"items\": [\n    {\n      \"id_produk\": 5,\n      \"jumlah\": 9999\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "10. DELETE metode salah",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 405\", function () { pm.response.to.have.status(405); });",
              "pm.test(\"Response JSON\", function () { pm.response.to.be.json; });"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{base_url}}/produk.php",
